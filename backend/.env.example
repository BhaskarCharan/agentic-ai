# Copy this file to `.env` and fill in real values. `.env` is gitignored -
# never commit real secrets.

# API key for Google's Generative Language API (Gemini). Get one at
# https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Which Gemini model the agent should use.
MODEL_NAME=gemini-flash-latest

# Connection string for the local MongoDB instance.
MONGO_URI=mongodb://localhost:27017

# Database name used for both chat-session metadata and LangGraph checkpoints.
MONGO_DB_NAME=agentic_ai_chat

# Origins allowed to call this API (comma-separated). The Angular dev server
# runs on 4200 by default.
CORS_ORIGINS=http://localhost:4200

# --- LangSmith tracing (optional) ---
# Off by default. Flip to true to see every LLM call/tool call/graph step in
# https://smith.langchain.com - get an API key there first (free tier is
# fine for local dev).
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-ai-chat
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Composio (Gmail/LinkedIn account linking - MULTI_AGENT_ROADMAP.md) ---
# Get an API key at https://app.composio.dev. No manual OAuth app / auth
# config setup needed - IntegrationService auto-provisions a
# Composio-managed auth config for each toolkit on first "Connect".
COMPOSIO_API_KEY=
# This app has no real user auth (see DEVELOPMENT_LOG.md) - one fixed id
# stands in for "the user" everywhere Composio needs one.
COMPOSIO_USER_ID=me
